generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// Menty — multi-tenant platform. Phase 1: tenancy foundation.
//
// The programme (MentorshipProgram) is the tenant boundary. A person has ONE
// User account and:
//   * participates in programmes through ProgramMembership (role per programme)
//   * administers through RoleAssignment (role at PLATFORM / INSTITUTION /
//     PROGRAM scope; permissions resolved in src/lib/rbac)
//
// User.role is LEGACY. It still drives the original MUBAS mentor/mentee
// dashboards until Phase 3 replaces them, but it is never used for
// authorisation of administrative actions. See docs/phase-0/.
// =============================================================================

// ----- Legacy enums ----------------------------------------------------------

enum Role {
  ADMIN
  MENTOR
  MENTEE
  /// Accounts created after Phase 1 that are not legacy mentors/mentees
  /// (coordinators, institution staff, invited people).
  USER
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PairingStatus {
  ACTIVE
  ENDED
}

enum Audience {
  ALL
  MENTORS
  MENTEES
}

enum NotificationType {
  WAITLIST
  APPROVAL
  PAIRING
  SYSTEM
}

enum IssueStatus {
  OPEN
  RESOLVED
}

// ----- Tenancy enums ---------------------------------------------------------

enum ScopeType {
  PLATFORM
  INSTITUTION
  PROGRAM
}

enum InstitutionStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ProgramOwnerType {
  PLATFORM
  INSTITUTION
  INDEPENDENT
}

enum ProgramStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
  SUSPENDED
}

enum ProgramVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum DeliveryModel {
  PRESENTER_LED
  ONE_TO_ONE
  HYBRID
}

enum DeliveryMode {
  ONLINE
  IN_PERSON
  BLENDED
}

enum MatchingMode {
  MANUAL
  AUTOMATIC
  HYBRID
}

enum ProgramRole {
  MENTOR
  MENTEE
  PRESENTER
  FACILITATOR
  PARTICIPANT
}

enum ThemeVariant {
  DRAFT
  PUBLISHED
}

enum Appearance {
  LIGHT
  DARK
  SYSTEM
}

enum TransferStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  CANCELLED
}

enum MembershipStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
  REMOVED
}

// ----- Identity --------------------------------------------------------------

model User {
  id              String     @id @default(cuid())
  name            String
  email           String     @unique
  passwordHash    String
  role            Role
  status          UserStatus @default(PENDING)
  phone           String?
  emailVerifiedAt DateTime?
  /// Incremented whenever the user's roles or status change. A session issued
  /// for an older version is rejected, so changes take effect immediately.
  sessionVersion  Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  mentorProfile           MentorProfile?
  menteeProfile           MenteeProfile?
  sentMessages            Message[]                @relation("SentMessages")
  receivedMessages        Message[]                @relation("ReceivedMessages")
  announcements           Announcement[]
  meetingsCreated         Meeting[]                @relation("MeetingCreatedBy")
  notifications           Notification[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  issueReports            IssueReport[]
  auditLogs               AuditLog[]

  invitesCreated         AdminInvite[]           @relation("InviteCreatedBy")
  requestedInstitutions  Institution[]           @relation("InstitutionRequester")
  roleAssignments        RoleAssignment[]        @relation("AssignmentSubject")
  grantedAssignments     RoleAssignment[]        @relation("AssignmentGrantedBy")
  institutionMemberships InstitutionMembership[]
  memberships            ProgramMembership[]
  ownedPrograms          MentorshipProgram[]     @relation("ProgramOwner")

  @@index([role, status])
  @@index([status])
}

// ----- RBAC ------------------------------------------------------------------

/// Which permission keys a role grants. Keys are declared in
/// src/lib/rbac/permissions.ts. For built-in (isSystem) roles the code-side
/// definition is authoritative; custom roles use `permissions` below.
model AdminRole {
  id            String      @id @default(cuid())
  key           String      @unique
  name          String
  description   String?
  allowedScopes ScopeType[]
  permissions   String[]
  isSystem      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  assignments RoleAssignment[]
  invites     AdminInvite[]
}

/// Single-use invitation to take a role (e.g. programme coordinator) for an
/// email address that has no Menty account yet. Stored hashed.
model AdminInvite {
  id            String    @id @default(cuid())
  email         String
  roleId        String
  scopeType     ScopeType
  institutionId String?
  programId     String?
  tokenHash     String    @unique
  expiresAt     DateTime
  acceptedAt    DateTime?
  revokedAt     DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())

  role        AdminRole          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  institution Institution?       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  program     MentorshipProgram? @relation(fields: [programId], references: [id], onDelete: Cascade)
  createdBy   User?              @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([programId])
  @@index([institutionId])
}

/// Grants a role to a user at one scope. PLATFORM: both ids null.
/// INSTITUTION: institutionId set. PROGRAM: programId set.
model RoleAssignment {
  id            String    @id @default(cuid())
  userId        String
  roleId        String
  scopeType     ScopeType
  institutionId String?
  programId     String?
  grantedById   String?
  expiresAt     DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user        User               @relation("AssignmentSubject", fields: [userId], references: [id], onDelete: Cascade)
  role        AdminRole          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  institution Institution?       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  program     MentorshipProgram? @relation(fields: [programId], references: [id], onDelete: Cascade)
  grantedBy   User?              @relation("AssignmentGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  // Partial unique indexes in the migration prevent duplicate live
  // assignments (Postgres treats NULLs as distinct in ordinary unique keys).
  @@index([userId, revokedAt])
  @@index([institutionId])
  @@index([programId])
}

// ----- Institutions ----------------------------------------------------------

model Institution {
  id                 String             @id @default(cuid())
  slug               String             @unique
  name               String
  shortName          String?
  description        String?
  websiteUrl         String?
  logoUrl            String?
  coverImageUrl      String?
  country            String             @default("Malawi")
  /// Registration request (public "register an institution" flow).
  requestedById      String?
  contactName        String?
  contactEmail       String?
  requestNote        String?
  status             InstitutionStatus  @default(PENDING_VERIFICATION)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  requestedBy User?                   @relation("InstitutionRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  domains     InstitutionDomain[]
  members     InstitutionMembership[]
  programs    MentorshipProgram[]
  assignments RoleAssignment[]
  themes      InstitutionTheme[]
  invites     AdminInvite[]
  transfersIn ProgramTransfer[]
}

model InstitutionTheme {
  id             String       @id @default(cuid())
  institutionId  String
  variant        ThemeVariant @default(PUBLISHED)
  primaryColor   String       @default("#00727a")
  secondaryColor String       @default("#272754")
  accentColor    String       @default("#8fdd36")
  updatedAt      DateTime     @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, variant])
}

/// Verifies institutional affiliation by email domain. Never a gate on who may
/// use Menty or join a programme.
model InstitutionDomain {
  id              String   @id @default(cuid())
  institutionId   String
  /// Normalised: lowercase, no leading '@', no trailing dot. Exact host match.
  domain          String   @unique
  allowSubdomains Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId])
}

/// A user's affiliation with an institution (a profile attribute).
model InstitutionMembership {
  id            String    @id @default(cuid())
  userId        String
  institutionId String
  verifiedEmail String?
  verifiedAt    DateTime?
  isPrimary     Boolean   @default(false)
  createdAt     DateTime  @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([userId, institutionId])
  @@index([institutionId])
}

// ----- Programmes -------------------------------------------------------------

/// A mentorship programme — the tenant boundary. Not to be confused with
/// `Programme`, which is the academic degree-programme catalogue.
model MentorshipProgram {
  id                   String             @id @default(cuid())
  slug                 String             @unique
  name                 String
  tagline              String?
  description          String?
  objectives           String?
  category             String?
  targetAudience       String?
  welcomeMessage       String?
  /// Public contact address; also the Reply-To on programme emails (Phase 8).
  contactEmail         String?
  ownerType            ProgramOwnerType
  institutionId        String?
  ownerUserId          String?
  status               ProgramStatus      @default(DRAFT)
  visibility           ProgramVisibility  @default(PUBLIC)
  verificationStatus   VerificationStatus @default(UNVERIFIED)
  deliveryModel        DeliveryModel      @default(PRESENTER_LED)
  deliveryMode         DeliveryMode       @default(ONLINE)
  matchingMode         MatchingMode?
  /// Dashboard modules switched on for this programme.
  enabledModules       String[]
  logoUrl              String?
  coverImageUrl        String?
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  startsAt             DateTime?
  endsAt               DateTime?
  durationLabel        String?
  capacity             Int?
  requiresApproval     Boolean            @default(true)
  eligibility          Json?
  matchingConfig       Json?
  careerTags           String[]
  publishedAt          DateTime?
  archivedAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  institution   Institution?        @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  owner         User?               @relation("ProgramOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  assignments   RoleAssignment[]
  memberships   ProgramMembership[]
  cohorts       Semester[]
  announcements Announcement[]
  pairings      Pairing[]
  meetings      Meeting[]
  themes        ProgramTheme[]
  invites       AdminInvite[]
  transfers     ProgramTransfer[]

  @@index([status, visibility])
  @@index([institutionId, status])
  @@index([ownerType])
}

/// A programme's visual identity. At most two rows: PUBLISHED (what
/// participants see) and DRAFT (what the branding editor works on).
/// Rendered as --program-* CSS custom properties; see src/lib/theme.
model ProgramTheme {
  id                String       @id @default(cuid())
  programId         String
  variant           ThemeVariant @default(PUBLISHED)
  primaryColor      String       @default("#00727a")
  primaryContrast   String       @default("#ffffff")
  secondaryColor    String       @default("#272754")
  secondaryContrast String       @default("#ffffff")
  accentColor       String       @default("#8fdd36")
  accentContrast    String       @default("#272754")
  backgroundColor   String       @default("#f7f9fa")
  foregroundColor   String       @default("#1a1b28")
  radius            String       @default("0.75rem")
  appearance        Appearance   @default(SYSTEM)
  updatedAt         DateTime     @updatedAt

  program MentorshipProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, variant])
}

/// Audited hand-over of an independent programme to an institution.
/// Participants and history stay put: only ownership changes.
model ProgramTransfer {
  id              String         @id @default(cuid())
  programId       String
  toInstitutionId String
  requestedById   String
  decidedById     String?
  status          TransferStatus @default(REQUESTED)
  note            String?
  createdAt       DateTime       @default(now())
  decidedAt       DateTime?

  program       MentorshipProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  toInstitution Institution       @relation(fields: [toInstitutionId], references: [id], onDelete: Cascade)

  @@index([programId, status])
  @@index([toInstitutionId, status])
}

/// One row per (programme, user, role). The same account may be MENTEE in one
/// programme, MENTOR in another, and MENTOR + PRESENTER in a third.
model ProgramMembership {
  id        String           @id @default(cuid())
  programId String
  userId    String
  role      ProgramRole
  status    MembershipStatus @default(PENDING)
  cohortId  String?
  expertise String[]
  capacity  Int?
  joinedAt  DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  program MentorshipProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohort  Semester?         @relation(fields: [cohortId], references: [id], onDelete: SetNull)

  @@unique([programId, userId, role])
  @@index([userId, status])
  @@index([programId, role, status])
}

/// Admin-editable platform settings and defaults.
model PlatformSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

// ----- Accounts (unchanged) --------------------------------------------------

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ----- Cohorts and one-to-one mentorship (legacy, now programme-scoped) ------

/// A programme cohort. Every existing semester belongs to the MUBAS
/// engineering programme after the Phase 1 migration.
model Semester {
  id               String   @id @default(cuid())
  name             String   @unique
  startDate        DateTime
  endDate          DateTime
  isActive         Boolean  @default(false)
  registrationOpen Boolean  @default(false)
  isArchived       Boolean  @default(false)
  programId        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  program        MentorshipProgram?  @relation(fields: [programId], references: [id], onDelete: SetNull)
  mentorProfiles MentorProfile[]
  menteeProfiles MenteeProfile[]
  pairings       Pairing[]
  announcements  Announcement[]
  memberships    ProgramMembership[]

  @@index([isActive])
  @@index([isArchived])
  @@index([programId])
}

model MentorProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  semesterId         String
  registrationNumber String
  yearOfStudy        Int
  programme          String
  department         String
  strongModules      String[]
  hoursPerWeek       Int
  maxMentees         Int      @default(3)
  crossDepartment    Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  semester  Semester         @relation(fields: [semesterId], references: [id])
  interests MentorInterest[]
  pairings  Pairing[]

  @@unique([registrationNumber, semesterId])
  @@index([semesterId])
  @@index([department])
}

model MenteeProfile {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  semesterId              String
  registrationNumber      String
  programme               String
  department              String
  sameDepartmentPreferred Boolean   @default(false)
  waitlisted              Boolean   @default(false)
  waitlistedAt            DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  semester  Semester         @relation(fields: [semesterId], references: [id])
  interests MenteeInterest[]
  pairings  Pairing[]

  @@unique([registrationNumber, semesterId])
  @@index([semesterId])
  @@index([department])
  @@index([waitlisted])
}

model Interest {
  id       String  @id @default(cuid())
  name     String  @unique
  isCustom Boolean @default(false)
  isActive Boolean @default(true)

  mentors MentorInterest[]
  mentees MenteeInterest[]
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Academic degree programme catalogue (NOT a mentorship programme).
model Programme {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model StrongModule {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model MentorInterest {
  mentorProfileId String
  interestId      String

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
  interest      Interest      @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([mentorProfileId, interestId])
  @@index([interestId])
}

model MenteeInterest {
  menteeProfileId String
  interestId      String

  menteeProfile MenteeProfile @relation(fields: [menteeProfileId], references: [id], onDelete: Cascade)
  interest      Interest      @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([menteeProfileId, interestId])
  @@index([interestId])
}

model Pairing {
  id              String        @id @default(cuid())
  mentorProfileId String
  menteeProfileId String
  semesterId      String
  programId       String?
  status          PairingStatus @default(ACTIVE)
  matchScore      Int           @default(0)
  createdAt       DateTime      @default(now())
  endedAt         DateTime?

  mentorProfile MentorProfile      @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
  menteeProfile MenteeProfile      @relation(fields: [menteeProfileId], references: [id], onDelete: Cascade)
  semester      Semester           @relation(fields: [semesterId], references: [id])
  program       MentorshipProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  meetings      Meeting[]

  @@index([mentorProfileId, status])
  @@index([menteeProfileId, status])
  @@index([semesterId, status])
  @@index([programId, status])
}

model Meeting {
  id              String   @id @default(cuid())
  pairingId       String
  programId       String?
  date            DateTime
  durationMinutes Int
  topics          String
  notes           String?
  createdById     String
  zoomMeetingId   String?
  zoomJoinUrl     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pairing   Pairing            @relation(fields: [pairingId], references: [id], onDelete: Cascade)
  program   MentorshipProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  createdBy User               @relation("MeetingCreatedBy", fields: [createdById], references: [id])

  @@index([pairingId])
  @@index([date])
  @@index([programId, date])
}

// ----- Platform services -----------------------------------------------------

model IssueReport {
  id          String      @id @default(cuid())
  reporterId  String
  subject     String
  description String
  status      IssueStatus @default(OPEN)
  createdAt   DateTime    @default(now())
  resolvedAt  DateTime?

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([reporterId])
}

model AuditLog {
  id            String   @id @default(cuid())
  actorId       String
  action        String
  targetType    String?
  targetId      String?
  institutionId String?
  programId     String?
  metadata      Json?
  createdAt     DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([institutionId, createdAt])
  @@index([programId, createdAt])
}

model Message {
  id          String    @id @default(cuid())
  senderId    String
  recipientId String
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  sender    User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
}

/// programId null = platform-wide announcement (Super Admin only).
model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  audience    Audience @default(ALL)
  semesterId  String?
  programId   String?
  createdById String
  emailSent   Boolean  @default(false)
  createdAt   DateTime @default(now())

  semester  Semester?          @relation(fields: [semesterId], references: [id])
  program   MentorshipProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  createdBy User               @relation(fields: [createdById], references: [id])

  @@index([audience, createdAt])
  @@index([semesterId])
  @@index([programId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}
