// =============================================================================
// Menty — PROPOSED target schema (Phase 0, reference only)
//
// This file is NOT used by the application. It shows the end state the phased
// migrations converge on. Phase 1 introduces the tenancy + RBAC part; later
// phases add their modules. Each phase ships its own forward-only migration.
//
// Legend in comments:
//   [KEEP]     existing model, unchanged or near-unchanged
//   [EXTEND]   existing model, new nullable/defaulted columns only
//   [RESHAPE]  October 2026 draft model, never used by code, redesigned here
//   [NEW]      new model
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

/// [KEEP for now] Platform account type. MENTOR/MENTEE are retired in the
/// Phase 10 contract migration once nothing reads them. Navigation and
/// authorisation never use this field after Phase 1.
enum Role {
  ADMIN
  MENTOR
  MENTEE
  USER // [NEW] default for every account created after Phase 1
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED // [NEW]
}

enum ScopeType {
  PLATFORM
  INSTITUTION
  PROGRAM
}

enum InstitutionStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum InstitutionMemberRole {
  ADMIN // institution administrator (mirrors an INSTITUTION RoleAssignment)
  MEMBER // affiliated staff/student
}

enum ProgramOwnerType {
  PLATFORM // Menty's own first-party programmes (volunteer mentor network)
  INSTITUTION
  INDEPENDENT
}

enum ProgramStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
  SUSPENDED
}

enum ProgramVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum DeliveryModel {
  PRESENTER_LED
  ONE_TO_ONE
  HYBRID
}

enum DeliveryMode {
  ONLINE
  IN_PERSON
  BLENDED
}

enum MatchingMode {
  MANUAL
  AUTOMATIC
  HYBRID
}

enum ProgramRole {
  MENTOR
  MENTEE
  PRESENTER
  FACILITATOR
  PARTICIPANT
}

enum MembershipStatus {
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
  REMOVED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
  WAITLISTED
}

enum FormStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FormFieldType {
  SECTION
  SHORT_TEXT
  LONG_TEXT
  EMAIL
  PHONE
  NUMBER
  DROPDOWN
  MULTI_SELECT
  RADIO
  CHECKBOXES
  DATE
  FILE
  UNIVERSITY
  DEPARTMENT
  YEAR_OF_STUDY
  INTERESTS
  SKILLS
  EXPERIENCE
}

enum ThemeVariant {
  DRAFT
  PUBLISHED
}

enum Appearance {
  LIGHT
  DARK
  SYSTEM
}

enum PairingStatus {
  PROPOSED
  ACTIVE
  ENDED
  CANCELLED
  REASSIGNMENT_REQUIRED
}

enum MatchingRunStatus {
  RUNNING
  AWAITING_REVIEW
  APPROVED
  DISCARDED
  FAILED
}

enum RecommendationDecision {
  PENDING
  ACCEPTED
  REJECTED
  EDITED
}

enum SessionStatus {
  DRAFT
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum MeetingProvider {
  ZOOM
  EXTERNAL_LINK
  IN_PERSON
}

enum MeetingStatus {
  SCHEDULED
  STARTED
  ENDED
  CANCELLED
}

enum AttendanceSource {
  ZOOM_WEBHOOK
  ZOOM_REPORT
  MANUAL
  SELF_CHECKIN
}

enum ResourceKind {
  FILE
  LINK
  ASSIGNMENT
}

enum MilestoneCompletionMode {
  MANUAL_CHECK // participant ticks it
  SUBMISSION // participant submits evidence, coordinator approves
  AUTO_ATTENDANCE // completed when the linked session is attended
  AUTO_PAIRING_MEETING // completed when a meeting is logged
}

enum MilestoneProgressStatus {
  PENDING
  SUBMITTED
  COMPLETED
  REJECTED
  WAIVED
}

enum Audience {
  ALL
  MENTORS
  MENTEES
  PRESENTERS
  PARTICIPANTS
  COORDINATORS
}

enum EmailKind {
  ANNOUNCEMENT
  PROGRAM_UPDATE
  MEETING_INVITATION
  MEETING_REMINDER
  SESSION_REMINDER
  REGISTRATION_CONFIRMATION
  APPROVAL
  REJECTION
  MATCH_NOTIFICATION
  MILESTONE_REMINDER
  DEADLINE_REMINDER
  GENERAL
}

enum EmailDeliveryStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED_PREFERENCE
}

enum SenderVerification {
  PENDING
  VERIFIED
  FAILED
}

enum ReminderStatus {
  SCHEDULED
  SENT
  CANCELLED
  FAILED
}

enum NotificationType {
  WAITLIST
  APPROVAL
  PAIRING
  SYSTEM
  SESSION
  MILESTONE
  ANNOUNCEMENT
  REGISTRATION
}

enum IntegrationKind {
  ZOOM
  GEMINI
  EMAIL_SMTP
  STORAGE
}

enum IssueStatus {
  OPEN
  RESOLVED
}

// ----------------------------------------------------------------------------
// Identity
// ----------------------------------------------------------------------------

/// [EXTEND] One account per person, across every programme.
model User {
  id              String     @id @default(cuid())
  name            String
  email           String     @unique
  passwordHash    String
  role            Role       @default(USER)
  status          UserStatus @default(APPROVED) // new accounts are usable; programme approval is separate
  phone           String?
  avatarUrl       String?
  emailVerifiedAt DateTime?
  /// [NEW] Incremented on role/assignment change or suspension: invalidates JWTs.
  sessionVersion  Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  profile                 UserProfile?
  notificationPreference  NotificationPreference?
  roleAssignments         RoleAssignment[]         @relation("AssignmentSubject")
  grantedAssignments      RoleAssignment[]         @relation("AssignmentGrantedBy")
  institutionMemberships  InstitutionMembership[]
  memberships             ProgramMembership[]
  applications            ProgramApplication[]
  ownedPrograms           MentorshipProgram[]      @relation("ProgramOwner")
  mentorProfiles          MentorProfile[]
  menteeProfiles          MenteeProfile[]
  presenterProfile        PresenterProfile?
  sessionPresentations    SessionPresenter[]
  sessionAttendance       SessionAttendance[]
  milestoneProgress       MilestoneProgress[]      @relation("ProgressOwner")
  reviewedMilestones      MilestoneProgress[]      @relation("ProgressReviewer")
  sentMessages            Message[]                @relation("SentMessages")
  receivedMessages        Message[]                @relation("ReceivedMessages")
  announcements           Announcement[]
  meetingsCreated         Meeting[]                @relation("MeetingCreatedBy")
  notifications           Notification[]
  emailDeliveries         EmailDelivery[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  issueReports            IssueReport[]
  auditLogs               AuditLog[]
  resourcesUploaded       Resource[]
  matchDecisions          MatchRecommendation[]

  @@index([status])
}

/// [NEW] Platform-wide profile attributes reused across programmes. Programme-
/// specific answers live in ProgramApplication.answers instead.
model UserProfile {
  userId         String   @id
  headline       String?
  bio            String?
  institutionText String? // free text when the institution is not on Menty
  department     String?
  yearOfStudy    Int?
  skills         String[]
  interests      String[]
  linkedinUrl    String?
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  userId            String  @id
  emailAnnouncements Boolean @default(true)
  emailReminders     Boolean @default(true)
  emailMatching      Boolean @default(true)
  /// Per-programme overrides: { [programId]: { emailReminders: false, ... } }
  programOverrides   Json?
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------------------------------
// RBAC (UniSpace pattern: keys in code, grants in DB, scoped assignments)
// ----------------------------------------------------------------------------

model AdminRole {
  id            String      @id @default(cuid())
  key           String      @unique // super_admin, institution_admin, program_coordinator, program_assistant
  name          String
  description   String?
  allowedScopes ScopeType[]
  permissions   String[]
  isSystem      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  assignments RoleAssignment[]
}

model RoleAssignment {
  id            String    @id @default(cuid())
  userId        String
  roleId        String
  scopeType     ScopeType
  institutionId String?
  programId     String?
  grantedById   String?
  expiresAt     DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user        User               @relation("AssignmentSubject", fields: [userId], references: [id], onDelete: Cascade)
  role        AdminRole          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  institution Institution?       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  program     MentorshipProgram? @relation(fields: [programId], references: [id], onDelete: Cascade)
  grantedBy   User?              @relation("AssignmentGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  // Partial unique indexes (hand-written SQL) cover the NULL columns, as in UniSpace.
  @@unique([userId, roleId, scopeType, institutionId, programId])
  @@index([userId, revokedAt])
  @@index([institutionId])
  @@index([programId])
}

model AdminInvite {
  id            String    @id @default(cuid())
  email         String
  roleId        String
  scopeType     ScopeType
  institutionId String?
  programId     String?
  tokenHash     String    @unique
  expiresAt     DateTime
  acceptedAt    DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())

  @@index([email])
}

// ----------------------------------------------------------------------------
// Institutions
// ----------------------------------------------------------------------------

/// [RESHAPE]
model Institution {
  id                 String             @id @default(cuid())
  slug               String             @unique
  name               String
  shortName          String?
  description        String?
  websiteUrl         String?
  logoUrl            String?
  coverImageUrl      String?
  country            String             @default("Malawi")
  status             InstitutionStatus  @default(PENDING_VERIFICATION)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  domains     InstitutionDomain[]
  members     InstitutionMembership[]
  programs    MentorshipProgram[]
  themes      InstitutionTheme[]
  assignments RoleAssignment[]
}

/// [KEEP] Used to *verify affiliation*, never to restrict platform access.
model InstitutionDomain {
  id              String   @id @default(cuid())
  institutionId   String
  domain          String   @unique
  allowSubdomains Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId])
}

/// [RESHAPE of InstitutionalAffiliation] A user may belong to many institutions.
model InstitutionMembership {
  id            String                @id @default(cuid())
  userId        String
  institutionId String
  role          InstitutionMemberRole @default(MEMBER)
  verifiedEmail String?
  verifiedAt    DateTime?
  isPrimary     Boolean               @default(false)
  createdAt     DateTime              @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([userId, institutionId])
  @@index([institutionId])
}

model InstitutionTheme {
  id             String       @id @default(cuid())
  institutionId  String
  variant        ThemeVariant @default(PUBLISHED)
  primaryColor   String       @default("#00727a")
  secondaryColor String       @default("#272754")
  accentColor    String       @default("#8fdd36")
  appearance     Appearance   @default(SYSTEM)
  updatedAt      DateTime     @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, variant])
}

// ----------------------------------------------------------------------------
// Programmes (the tenant boundary)
// ----------------------------------------------------------------------------

/// [RESHAPE]
model MentorshipProgram {
  id                 String             @id @default(cuid())
  slug               String             @unique
  name               String
  tagline            String?
  description        String?
  objectives         String?
  category           String? // links to a ProgramCategory row by slug (editable list)
  targetAudience     String?
  welcomeMessage     String?
  ownerType          ProgramOwnerType
  institutionId      String?
  ownerUserId        String?
  status             ProgramStatus      @default(DRAFT)
  visibility         ProgramVisibility  @default(PUBLIC)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  deliveryModel      DeliveryModel      @default(PRESENTER_LED)
  deliveryMode       DeliveryMode       @default(ONLINE)
  matchingMode       MatchingMode? // only for ONE_TO_ONE / HYBRID
  /// Dashboard modules switched on for this programme, e.g. ["sessions","pairings","milestones"].
  enabledModules     String[]
  logoUrl            String?
  coverImageUrl      String?
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  startsAt           DateTime?
  endsAt             DateTime?
  durationLabel      String? // "12 weeks"
  capacity           Int?
  requiresApproval   Boolean            @default(true)
  /// Structured eligibility rules (see Phase 4): { mode: "OPEN" | "INSTITUTIONS" | ..., institutionIds, departments, years, inviteOnly, custom }
  eligibility        Json?
  matchingConfig     Json? // weights, hard constraints, AI on/off
  careerTags         String[]
  publishedAt        DateTime?
  archivedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  institution    Institution?          @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  owner          User?                 @relation("ProgramOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  themes         ProgramTheme[]
  assignments    RoleAssignment[]
  memberships    ProgramMembership[]
  cohorts        Semester[]
  forms          RegistrationForm[]
  applications   ProgramApplication[]
  sessions       MentorshipSession[]
  pairings       Pairing[]
  matchingRuns   MatchingRun[]
  meetings       Meeting[]
  milestones     Milestone[]
  resources      Resource[]
  announcements  Announcement[]
  emailTemplates EmailTemplate[]
  senderIdentities SenderIdentity[]
  reminders      Reminder[]
  integrations   Integration[]
  transfers      ProgramTransfer[]

  @@index([status, visibility])
  @@index([institutionId, status])
  @@index([ownerType])
}

model ProgramTheme {
  id              String       @id @default(cuid())
  programId       String
  variant         ThemeVariant @default(PUBLISHED)
  primaryColor    String       @default("#00727a")
  primaryContrast String       @default("#ffffff")
  secondaryColor  String       @default("#272754")
  secondaryContrast String     @default("#ffffff")
  accentColor     String       @default("#8fdd36")
  accentContrast  String       @default("#272754")
  backgroundColor String       @default("#f7f9fa")
  foregroundColor String       @default("#1a1b28")
  radius          String       @default("0.75rem")
  appearance      Appearance   @default(SYSTEM)
  updatedAt       DateTime     @updatedAt

  program MentorshipProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, variant])
}

/// Audited hand-over of an independent programme to an institution.
model ProgramTransfer {
  id                String    @id @default(cuid())
  programId         String
  toInstitutionId   String
  requestedById     String
  decidedById       String?
  status            String // REQUESTED | ACCEPTED | DECLINED | CANCELLED
  createdAt         DateTime  @default(now())
  decidedAt         DateTime?

  program MentorshipProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
}

/// [RESHAPE] One row per (user, programme, role). PENDING until registration approved.
model ProgramMembership {
  id            String           @id @default(cuid())
  programId     String
  userId        String
  role          ProgramRole
  status        MembershipStatus @default(PENDING)
  cohortId      String?
  applicationId String?          @unique
  expertise     String[] // presenter / mentor areas within this programme
  capacity      Int? // mentor capacity in this programme (overrides profile)
  joinedAt      DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  program     MentorshipProgram   @relation(fields: [programId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohort      Semester?           @relation(fields: [cohortId], references: [id])
  application ProgramApplication? @relation(fields: [applicationId], references: [id])

  @@unique([programId, userId, role])
  @@index([userId, status])
  @@index([programId, role, status])
}

// ----------------------------------------------------------------------------
// Registration forms
// ----------------------------------------------------------------------------

/// [RESHAPE] Versioned; a published version is immutable, edits create a new draft version.
model RegistrationForm {
  id          String      @id @default(cuid())
  programId   String
  role        ProgramRole
  title       String
  description String?
  status      FormStatus  @default(DRAFT)
  version     Int         @default(1)
  publishedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  program      MentorshipProgram    @relation(fields: [programId], references: [id], onDelete: Cascade)
  fields       FormField[]
  applications ProgramApplication[]

  @@unique([programId, role, version])
}

model FormField {
  id          String        @id @default(cuid())
  formId      String
  key         String // stable machine key, used in answers JSON
  label       String
  description String?
  type        FormFieldType
  required    Boolean       @default(false)
  options     Json? // [{ value, label }]
  validation  Json? // { min, max, maxLength, pattern, maxFileMb, accept }
  /// { fieldKey, operator: "equals"|"includes", value } — evaluated server-side
  showIf      Json?
  /// Marks a field as an input to matching, and which profile signal it feeds.
  matchingSignal String? // "skills" | "interests" | "career_goals" | "availability" ...
  order       Int

  form RegistrationForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, key])
  @@index([formId, order])
}

/// [RESHAPE] The FormSubmission of the brief. answers = { [fieldKey]: value }.
model ProgramApplication {
  id          String            @id @default(cuid())
  programId   String
  userId      String
  role        ProgramRole
  formId      String
  formVersion Int
  answers     Json
  status      ApplicationStatus @default(SUBMITTED)
  reviewerId  String?
  reviewedAt  DateTime?
  reviewNote  String?
  cohortId    String?
  submittedAt DateTime          @default(now())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  program    MentorshipProgram  @relation(fields: [programId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  form       RegistrationForm   @relation(fields: [formId], references: [id])
  cohort     Semester?          @relation(fields: [cohortId], references: [id])
  membership ProgramMembership?
  files      FileUpload[]

  // + partial unique index: one live application per (programId, userId, role)
  @@index([programId, status, submittedAt])
  @@index([userId, status])
}

model FileUpload {
  id            String   @id @default(cuid())
  programId     String?
  applicationId String?
  uploadedById  String
  storageKey    String
  fileName      String
  contentType   String
  sizeBytes     Int
  createdAt     DateTime @default(now())

  application ProgramApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([programId])
}

// ----------------------------------------------------------------------------
// Cohorts and legacy one-to-one profiles
// ----------------------------------------------------------------------------

/// [EXTEND] The cohort. Table name kept to avoid churn; `programId` required after Phase 10.
model Semester {
  id               String   @id @default(cuid())
  name             String
  startDate        DateTime
  endDate          DateTime
  isActive         Boolean  @default(false)
  registrationOpen Boolean  @default(false)
  isArchived       Boolean  @default(false)
  programId        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  program        MentorshipProgram?   @relation(fields: [programId], references: [id])
  mentorProfiles MentorProfile[]
  menteeProfiles MenteeProfile[]
  pairings       Pairing[]
  announcements  Announcement[]
  applications   ProgramApplication[]
  memberships    ProgramMembership[]

  // Was @unique(name); becomes unique per programme.
  @@unique([programId, name])
  @@index([isActive])
  @@index([programId])
}

/// [EXTEND] Kept for the first-party programme's existing data and the rule-based engine.
model MentorProfile {
  id                 String   @id @default(cuid())
  userId             String
  semesterId         String
  programId          String? // [NEW] denormalised tenant key
  registrationNumber String
  yearOfStudy        Int
  programme          String
  department         String
  strongModules      String[]
  hoursPerWeek       Int
  maxMentees         Int      @default(3)
  crossDepartment    Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  semester  Semester         @relation(fields: [semesterId], references: [id])
  interests MentorInterest[]
  pairings  Pairing[]

  @@unique([registrationNumber, semesterId])
  @@index([userId])
  @@index([programId])
}

model MenteeProfile {
  id                      String    @id @default(cuid())
  userId                  String
  semesterId              String
  programId               String?
  registrationNumber      String
  programme               String
  department              String
  sameDepartmentPreferred Boolean   @default(false)
  waitlisted              Boolean   @default(false)
  waitlistedAt            DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  semester  Semester         @relation(fields: [semesterId], references: [id])
  interests MenteeInterest[]
  pairings  Pairing[]

  @@unique([registrationNumber, semesterId])
  @@index([userId])
  @@index([programId])
}

/// [NEW] Platform-level presenter profile, reused across programmes.
model PresenterProfile {
  userId      String   @id
  title       String?
  organisation String?
  expertise   String[]
  bio         String?
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// [KEEP] catalogs
model Interest {
  id       String  @id @default(cuid())
  name     String  @unique
  isCustom Boolean @default(false)
  isActive Boolean @default(true)

  mentors MentorInterest[]
  mentees MenteeInterest[]
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Academic degree programme (NOT a mentorship programme).
model Programme {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model StrongModule {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ProgramCategory {
  id        String  @id @default(cuid())
  slug      String  @unique
  label     String
  isActive  Boolean @default(true)
  order     Int     @default(0)
}

model MentorInterest {
  mentorProfileId String
  interestId      String

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
  interest      Interest      @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([mentorProfileId, interestId])
  @@index([interestId])
}

model MenteeInterest {
  menteeProfileId String
  interestId      String

  menteeProfile MenteeProfile @relation(fields: [menteeProfileId], references: [id], onDelete: Cascade)
  interest      Interest      @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([menteeProfileId, interestId])
  @@index([interestId])
}

// ----------------------------------------------------------------------------
// One-to-one mentorship and matching
// ----------------------------------------------------------------------------

/// [EXTEND] Legacy pairs reference profiles; new programmes reference memberships.
model Pairing {
  id                 String        @id @default(cuid())
  programId          String? // [NEW] required after Phase 10
  semesterId         String?
  mentorProfileId    String?
  menteeProfileId    String?
  mentorMembershipId String? // [NEW]
  menteeMembershipId String? // [NEW]
  status             PairingStatus @default(ACTIVE)
  matchScore         Int           @default(0)
  source             String        @default("RULES") // RULES | AI | MANUAL | LEGACY
  recommendationId   String?       @unique
  createdAt          DateTime      @default(now())
  endedAt            DateTime?

  program        MentorshipProgram?   @relation(fields: [programId], references: [id])
  mentorProfile  MentorProfile?       @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
  menteeProfile  MenteeProfile?       @relation(fields: [menteeProfileId], references: [id], onDelete: Cascade)
  semester       Semester?            @relation(fields: [semesterId], references: [id])
  recommendation MatchRecommendation? @relation(fields: [recommendationId], references: [id])
  meetings       Meeting[]

  @@index([programId, status])
  @@index([mentorMembershipId, status])
  @@index([menteeMembershipId, status])
}

model MatchingRun {
  id               String            @id @default(cuid())
  programId        String
  startedById      String
  provider         String // "gemini" | "rules"
  model            String? // e.g. "gemini-2.5-flash"
  algorithmVersion String
  config           Json // weights + constraints snapshot
  status           MatchingRunStatus @default(RUNNING)
  error            String?
  startedAt        DateTime          @default(now())
  completedAt      DateTime?
  approvedAt       DateTime?
  approvedById     String?

  program         MentorshipProgram     @relation(fields: [programId], references: [id], onDelete: Cascade)
  recommendations MatchRecommendation[]

  @@index([programId, startedAt])
}

model MatchRecommendation {
  id                 String                 @id @default(cuid())
  runId              String
  mentorMembershipId String
  menteeMembershipId String
  score              Int // 0–100
  explanation        String
  strengths          String[]
  concerns           String[]
  selected           Boolean                @default(false) // chosen by the assignment optimiser
  decision           RecommendationDecision @default(PENDING)
  decidedById        String?
  decidedAt          DateTime?

  run       MatchingRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  decidedBy User?       @relation(fields: [decidedById], references: [id])
  pairing   Pairing?

  @@unique([runId, mentorMembershipId, menteeMembershipId])
  @@index([runId, selected])
}

// ----------------------------------------------------------------------------
// Presenter-led sessions
// ----------------------------------------------------------------------------

model MentorshipSession {
  id             String        @id @default(cuid())
  programId      String
  title          String
  description    String?
  objectives     String?
  agenda         String?
  startsAt       DateTime
  durationMinutes Int
  timezone       String        @default("Africa/Blantyre")
  status         SessionStatus @default(SCHEDULED)
  /// Recurring sessions share a seriesId; each occurrence is its own row.
  seriesId       String?
  recurrenceRule String? // RFC 5545 RRULE, stored on the first occurrence
  location       String? // for in-person sessions
  allowQuestions Boolean       @default(true)
  recordingUrl   String?
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  program    MentorshipProgram   @relation(fields: [programId], references: [id], onDelete: Cascade)
  presenters SessionPresenter[]
  attendance SessionAttendance[]
  meeting    Meeting?
  resources  Resource[]
  questions  SessionQuestion[]
  feedback   SessionFeedback[]
  milestones Milestone[]

  @@index([programId, startsAt])
  @@index([seriesId])
}

model SessionPresenter {
  sessionId String
  userId    String
  role      String  @default("PRESENTER") // PRESENTER | CO_PRESENTER | GUEST | FACILITATOR
  topic     String?

  session MentorshipSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionId, userId])
  @@index([userId])
}

/// Audience = every ACTIVE member of the programme; rows are created on join/attendance,
/// not pre-assigned (no small groups).
model SessionAttendance {
  id              String           @id @default(cuid())
  sessionId       String
  userId          String
  registeredAt    DateTime?
  joinedAt        DateTime?
  leftAt          DateTime?
  durationSeconds Int?
  source          AttendanceSource @default(MANUAL)

  session MentorshipSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId])
}

model SessionQuestion {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  body      String
  answered  Boolean  @default(false)
  createdAt DateTime @default(now())

  session MentorshipSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model SessionFeedback {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  session MentorshipSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
}

// ----------------------------------------------------------------------------
// Meetings (pairing meetings and session meetings)
// ----------------------------------------------------------------------------

/// [EXTEND] A meeting belongs to a pairing (existing meeting log) OR a session.
model Meeting {
  id                String          @id @default(cuid())
  programId         String? // [NEW]
  pairingId         String?
  sessionId         String?         @unique
  provider          MeetingProvider @default(EXTERNAL_LINK)
  status            MeetingStatus   @default(SCHEDULED)
  date              DateTime
  durationMinutes   Int
  topics            String
  notes             String?
  createdById       String
  externalUrl       String?
  zoomMeetingId     String?         @unique
  zoomJoinUrl       String?
  zoomPasswordEnc   String? // encrypted at rest; never sent to non-participants
  zoomHostEmail     String?
  waitingRoom       Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  program   MentorshipProgram? @relation(fields: [programId], references: [id])
  pairing   Pairing?           @relation(fields: [pairingId], references: [id], onDelete: Cascade)
  session   MentorshipSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdBy User               @relation("MeetingCreatedBy", fields: [createdById], references: [id])

  @@index([pairingId])
  @@index([programId, date])
}

// ----------------------------------------------------------------------------
// Resources and milestones
// ----------------------------------------------------------------------------

model Resource {
  id           String       @id @default(cuid())
  programId    String
  sessionId    String?
  milestoneId  String?
  kind         ResourceKind
  title        String
  description  String?
  url          String? // LINK
  storageKey   String? // FILE
  contentType  String?
  sizeBytes    Int?
  visibleTo    ProgramRole[] // empty = every member
  uploadedById String
  createdAt    DateTime     @default(now())

  program    MentorshipProgram  @relation(fields: [programId], references: [id], onDelete: Cascade)
  session    MentorshipSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  milestone  Milestone?         @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  uploadedBy User               @relation(fields: [uploadedById], references: [id])

  @@index([programId, createdAt])
  @@index([sessionId])
}

/// Templates are seeded rows (platform-wide, programId null) that coordinators copy.
model MilestoneTemplate {
  id            String  @id @default(cuid())
  key           String  @unique // general | presenter_led | one_to_one
  name          String
  deliveryModel DeliveryModel?
  /// [{ title, description, mandatory, completionMode, offsetDays }]
  items         Json
  isActive      Boolean @default(true)
}

model Milestone {
  id             String                  @id @default(cuid())
  programId      String
  title          String
  description    String?
  order          Int
  dueAt          DateTime?
  mandatory      Boolean                 @default(true)
  completionMode MilestoneCompletionMode @default(MANUAL_CHECK)
  sessionId      String? // for AUTO_ATTENDANCE
  /// null = every participant; otherwise only listed roles
  appliesToRoles ProgramRole[]
  /// Selected participants only (membership ids); empty = all in appliesToRoles
  assignedMembershipIds String[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  program   MentorshipProgram   @relation(fields: [programId], references: [id], onDelete: Cascade)
  session   MentorshipSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  progress  MilestoneProgress[]
  resources Resource[]

  @@index([programId, order])
}

model MilestoneProgress {
  id           String                  @id @default(cuid())
  milestoneId  String
  userId       String
  status       MilestoneProgressStatus @default(PENDING)
  submission   String?
  submissionUrl String?
  submittedAt  DateTime?
  completedAt  DateTime?
  reviewerId   String?
  reviewNote   String?

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  user      User      @relation("ProgressOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewer  User?     @relation("ProgressReviewer", fields: [reviewerId], references: [id])

  @@unique([milestoneId, userId])
  @@index([userId, status])
}

// ----------------------------------------------------------------------------
// Communications
// ----------------------------------------------------------------------------

/// [EXTEND]
model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  audience    Audience @default(ALL)
  semesterId  String?
  programId   String? // null = platform-wide (Super Admin only)
  sessionId   String?
  createdById String
  emailSent   Boolean  @default(false)
  createdAt   DateTime @default(now())

  semester  Semester?          @relation(fields: [semesterId], references: [id])
  program   MentorshipProgram? @relation(fields: [programId], references: [id])
  createdBy User               @relation(fields: [createdById], references: [id])

  @@index([programId, createdAt])
}

model EmailTemplate {
  id        String    @id @default(cuid())
  programId String? // null = platform default
  kind      EmailKind
  subject   String // supports {{participant_name}}, {{program_name}}, {{session_date}} ...
  bodyMarkdown String
  footer    String?
  isActive  Boolean   @default(true)
  updatedAt DateTime  @updatedAt

  program MentorshipProgram? @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, kind])
}

model SenderIdentity {
  id           String             @id @default(cuid())
  programId    String
  displayName  String // "Engineering Mentorship Coordinator"
  fromEmail    String? // used only when verification = VERIFIED
  replyToEmail String
  verification SenderVerification @default(PENDING)
  verifiedAt   DateTime?
  isDefault    Boolean            @default(false)
  createdAt    DateTime           @default(now())

  program MentorshipProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
}

model EmailDelivery {
  id          String              @id @default(cuid())
  programId   String?
  userId      String?
  toEmail     String
  kind        EmailKind
  subject     String
  /// Dedup key, e.g. "reminder:<reminderId>:<userId>" — unique to prevent duplicates.
  dedupKey    String?             @unique
  status      EmailDeliveryStatus @default(QUEUED)
  error       String?
  providerMessageId String?
  createdAt   DateTime            @default(now())
  sentAt      DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([programId, createdAt])
  @@index([status])
}

model Reminder {
  id         String         @id @default(cuid())
  programId  String
  kind       EmailKind
  targetType String // SESSION | MEETING | MILESTONE | REGISTRATION_DEADLINE | PENDING_APPROVALS
  targetId   String?
  sendAt     DateTime
  status     ReminderStatus @default(SCHEDULED)
  attempts   Int            @default(0)
  lastError  String?
  createdAt  DateTime       @default(now())
  sentAt     DateTime?

  program MentorshipProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([kind, targetType, targetId, sendAt])
  @@index([status, sendAt])
}

/// [EXTEND]
model Message {
  id          String    @id @default(cuid())
  senderId    String
  recipientId String
  programId   String? // [NEW] context of the conversation
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  sender    User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
}

/// [EXTEND]
model Notification {
  id        String           @id @default(cuid())
  userId    String
  programId String?
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// ----------------------------------------------------------------------------
// Integrations, settings, audit
// ----------------------------------------------------------------------------

/// Platform-wide integrations use programId = null and env-var credentials.
/// Programme-specific integrations store an encrypted credential reference.
model Integration {
  id          String          @id @default(cuid())
  programId   String?
  kind        IntegrationKind
  isEnabled   Boolean         @default(true)
  config      Json? // non-secret settings (default host email, waiting room ...)
  secretEnc   String? // AES-GCM with INTEGRATION_ENCRYPTION_KEY; never returned to the client
  updatedAt   DateTime        @updatedAt

  program MentorshipProgram? @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, kind])
}

model PlatformSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

/// [EXTEND]
model AuditLog {
  id            String   @id @default(cuid())
  actorId       String
  action        String
  targetType    String?
  targetId      String?
  institutionId String?
  programId     String?
  metadata      Json? // scrubbed of secrets before write
  createdAt     DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([institutionId, createdAt])
  @@index([programId, createdAt])
}

model ProcessedWebhook {
  id         String   @id // provider event id, for idempotency
  provider   String
  receivedAt DateTime @default(now())
}

// [KEEP]
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model IssueReport {
  id          String      @id @default(cuid())
  reporterId  String
  programId   String?
  subject     String
  description String
  status      IssueStatus @default(OPEN)
  createdAt   DateTime    @default(now())
  resolvedAt  DateTime?

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}
